Install a tracy.pc matching the exported CMake target, and propagate
optional client library dependencies consistently across CMake and pkg-config.
Upstream generates tracy.pc only from its Meson build.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -90,15 +90,15 @@
 if(TRACY_LIBUNWIND_BACKTRACE)
     include(FindPkgConfig)
     pkg_check_modules(unwind REQUIRED libunwind)
-    target_include_directories(TracyClient INTERFACE ${unwind_INCLUDE_DIRS})
-    target_link_libraries(TracyClient INTERFACE ${unwind_LINK_LIBRARIES})
+    target_include_directories(TracyClient PUBLIC ${unwind_INCLUDE_DIRS})
+    target_link_libraries(TracyClient PUBLIC ${unwind_LINK_LIBRARIES})
 endif()
 
 if(TRACY_DEBUGINFOD)
     include(FindPkgConfig)
     pkg_check_modules(debuginfod REQUIRED libdebuginfod)
-    target_include_directories(TracyClient INTERFACE ${debuginfod_INCLUDE_DIRS})
-    target_link_libraries(TracyClient INTERFACE ${debuginfod_LINK_LIBRARIES})
+    target_include_directories(TracyClient PUBLIC ${debuginfod_INCLUDE_DIRS})
+    target_link_libraries(TracyClient PUBLIC ${debuginfod_LINK_LIBRARIES})
 endif()
 
 add_library(Tracy::TracyClient ALIAS TracyClient)
@@ -282,6 +282,43 @@
 install(FILES "${CMAKE_CURRENT_BINARY_DIR}/TracyConfigVersion.cmake"
         DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME})
 
+# Keep pkg-config consumers consistent with the installed CMake target.
+get_target_property(tracy_pc_definitions TracyClient INTERFACE_COMPILE_DEFINITIONS)
+set(tracy_pc_cflags "")
+if(tracy_pc_definitions)
+    foreach(definition IN LISTS tracy_pc_definitions)
+        string(REPLACE "\"" "\\\"" definition "${definition}")
+        string(APPEND tracy_pc_cflags " -D${definition}")
+    endforeach()
+endif()
+set(tracy_pc_libs_private "${CMAKE_THREAD_LIBS_INIT}")
+foreach(library IN LISTS CMAKE_DL_LIBS)
+    string(APPEND tracy_pc_libs_private " -l${library}")
+endforeach()
+# Also allow C programs to link the static C++ client with their C linker.
+foreach(library IN ITEMS stdc++ c++)
+    if(library IN_LIST CMAKE_CXX_IMPLICIT_LINK_LIBRARIES)
+        string(APPEND tracy_pc_libs_private " -l${library}")
+    endif()
+endforeach()
+if(rocprofiler-sdk_FOUND AND TARGET rocprofiler-sdk::rocprofiler-sdk-shared-library)
+    get_target_property(tracy_rocprof_lib rocprofiler-sdk::rocprofiler-sdk-shared-library LOCATION)
+    if(tracy_rocprof_lib)
+        string(APPEND tracy_pc_libs_private " ${tracy_rocprof_lib}")
+    endif()
+endif()
+set(tracy_pc_requires "")
+set(tracy_pc_requires_private "")
+if(TRACY_LIBUNWIND_BACKTRACE)
+    # TracyCallstack.hpp calls unw_backtrace inline from consumer translation units.
+    string(APPEND tracy_pc_requires " libunwind")
+endif()
+if(TRACY_DEBUGINFOD)
+    string(APPEND tracy_pc_requires_private " libdebuginfod")
+endif()
+configure_file(cmake/tracy.pc.in tracy.pc @ONLY)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/tracy.pc" DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
+
 option(TRACY_CLIENT_PYTHON "Whether to build Tracy python client library" OFF)
 
 if(TRACY_CLIENT_PYTHON)
