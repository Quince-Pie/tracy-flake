--- a/cmake/GitRef.cmake
+++ b/cmake/GitRef.cmake
@@ -1,4 +1,13 @@
 function(add_git_ref target)
+    if(DEFINED TRACY_GIT_REF)
+        # Release archives have no .git directory. Generate a header in each
+        # component's binary directory when building several tools together.
+        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/GitRef.hpp"
+            "#pragma once\nnamespace tracy { static inline const char* GitRef = \"${TRACY_GIT_REF}\"; }\n")
+        target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
+        return()
+    endif()
+
     if(NOT DEFINED GIT_REV)
         set(GIT_REV "HEAD")
     endif()
