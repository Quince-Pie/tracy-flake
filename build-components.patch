Build the profiler and tools in the top-level project, so the client library,
vendored dependencies and server library are configured and compiled once.
Release archives have no .git directory, so take the version reference as an option.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -323,3 +323,23 @@
 if(PROJECT_IS_TOP_LEVEL)
     set(CMAKE_COLOR_DIAGNOSTICS ON)
 endif()
+
+option(TRACY_BUILD_PROFILER "Build the graphical profiler" OFF)
+option(TRACY_BUILD_TOOLS "Build the command-line tools" OFF)
+
+if(TRACY_BUILD_PROFILER OR TRACY_BUILD_TOOLS)
+    enable_language(C)
+    set(CMAKE_CXX_STANDARD 20)
+    include(cmake/config.cmake)
+    set(VENDOR_GUI ${TRACY_BUILD_PROFILER})
+    include(cmake/vendor.cmake)
+
+    if(TRACY_BUILD_PROFILER)
+        add_subdirectory(profiler)
+    endif()
+    if(TRACY_BUILD_TOOLS)
+        foreach(tool capture csvexport import update merge)
+            add_subdirectory(${tool})
+        endforeach()
+    endif()
+endif()
--- a/cmake/server.cmake
+++ b/cmake/server.cmake
@@ -1,3 +1,14 @@
+# The statistics option changes both Worker behavior and its class layout.
+# Share compiled code only among tools using the same configuration.
+if(NO_STATISTICS)
+    set(TRACY_SERVER_TARGET TracyServerNoStatistics)
+else()
+    set(TRACY_SERVER_TARGET TracyServer)
+endif()
+if(TARGET ${TRACY_SERVER_TARGET})
+    return()
+endif()
+
 set(TRACY_COMMON_DIR ${CMAKE_CURRENT_LIST_DIR}/../public/common)
 
 set(TRACY_COMMON_SOURCES
@@ -28,9 +39,18 @@
 list(TRANSFORM TRACY_SERVER_SOURCES PREPEND "${TRACY_SERVER_DIR}/")
 
 
-add_library(TracyServer STATIC EXCLUDE_FROM_ALL ${TRACY_COMMON_SOURCES} ${TRACY_SERVER_SOURCES})
-target_include_directories(TracyServer PUBLIC ${TRACY_COMMON_DIR} ${TRACY_SERVER_DIR})
-target_link_libraries(TracyServer PUBLIC TracyCapstone libzstd PPQSort::PPQSort)
+find_package(Threads REQUIRED)
+
+# The common transport/compression sources do not depend on NO_STATISTICS.
+if(NOT TARGET TracyCommon)
+    add_library(TracyCommon STATIC EXCLUDE_FROM_ALL ${TRACY_COMMON_SOURCES})
+    target_include_directories(TracyCommon PUBLIC ${TRACY_COMMON_DIR})
+    target_link_libraries(TracyCommon PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
+endif()
+
+add_library(${TRACY_SERVER_TARGET} STATIC EXCLUDE_FROM_ALL ${TRACY_SERVER_SOURCES})
+target_include_directories(${TRACY_SERVER_TARGET} PUBLIC ${TRACY_COMMON_DIR} ${TRACY_SERVER_DIR})
+target_link_libraries(${TRACY_SERVER_TARGET} PUBLIC TracyCommon TracyCapstone libzstd PPQSort::PPQSort)
 if(NO_STATISTICS)
-    target_compile_definitions(TracyServer PUBLIC TRACY_NO_STATISTICS)
+    target_compile_definitions(${TRACY_SERVER_TARGET} PUBLIC TRACY_NO_STATISTICS)
 endif()
